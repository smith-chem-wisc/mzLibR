\item{\code{mzlib_usage_error} (usage)}{path missing or blank; file or directory not found}
\item{\code{mzlib_usage_error} (usage)}{mzLib does not recognise the file type (the message points at readers formats)}
\item{\code{mzlib_usage_error} (usage)}{offset, limit or out given with no value; offset or limit < 0; non-integer value; out resolves to the same file as path}

\name{readers_read_records}
\alias{readers_read_records}
\title{Read any file mzLib recognises, into that format's own fields}
\usage{
readers_read_records(path, limit = NULL, offset = 0, out = NULL, timeout = NULL)
}
\arguments{
\item{path}{Path to any file mzLib recognises. A Bruker \code{.d} directory is also accepted.}

\item{limit}{Maximum records to return. \code{NULL}, the default, returns all of them.}

\item{offset}{Records to skip. A window, not a cursor - see \code{\link{readers_read_results}}.}

\item{out}{Write a \strong{tab-separated} table here and return only a summary. Read it with

\section{Parameters: units, ranges and defaults}{
\describe{
\item{\code{databases} (wire \code{--path})}{path; default absent. One database: UniProt XML (.xml) or FASTA (.fasta, .fa, .faa, .fas), each optionally .gz. Exactly one of path and paths-stdin.}
\item{\code{contaminants} (wire \code{--contaminant})}{flag; default \code{FALSE}. Load the \code{--path} database as contaminants (mzLib isContaminant). Usage error with paths-stdin.}
\item{wire \code{--paths-stdin}}{flag; default \code{FALSE}. Databases on stdin, one per line, each optionally followed by a tab and 'contaminant' or 'target'. Blank lines ignored; a repeated path is a usage error (BULK.md §1). \emph{Not an argument here: chosen automatically when more than one database is given.}}
\item{\code{accessions} (wire \code{--accessions-stdin})}{flag; default \code{FALSE}. Keep only proteins whose accession exactly equals one read from stdin (one per line). With paths-stdin, stdin holds the paths, then a line holding only '--', then the accessions. Applies to every table.}
\item{\code{tables}}{string[]; default \code{proteins}; range \code{subset of proteins, go_terms, ensembl_genes}. Comma list of the tables to return. A table not asked for is null.}
\item{\code{sequences}}{flag; default \code{FALSE}. Add a sequence column to the proteins table.}
\item{\code{threads}}{int; default \code{1}; range \code{>= 1, or -1 for every core}. Databases loaded at once. Output is byte-identical at any value (tested at 1 and 4). mzLib's own maxThreads is pinned to 1 per load, so the degree is owned here alone.}
\item{\code{on_error} (wire \code{--on-error})}{string; default \code{fail}; range \code{fail | skip}. fail raises the failure of the LOWEST failing input index; skip records it in files[i].error and reads the rest.}
}
}
\section{Returned fields}{
Each field with its type, its unit, and what \code{NA} means when it is \code{NA}.

\describe{
\item{\code{file_count}}{int; in \strong{files}; never \code{NA}. Databases given.}
\item{\code{read_count}}{int; in \strong{files}; never \code{NA}. Databases read.}
\item{\code{failed_count}}{int; in \strong{files}; never \code{NA}. Databases that failed (on-error skip only).}
\item{\code{record_count}}{int; in \strong{proteins}; never \code{NA}. Proteins that passed the accession filter (rows of the proteins table when requested).}
\item{\code{tables}}{string[]; never \code{NA}. The tables returned, in the order proteins, go_terms, ensembl_genes.}
\item{\code{accession_filter_count}}{int; in \strong{accessions}; \code{NA} when no accession filter was given. Distinct accessions in the filter.}
\item{\code{accessions_not_found}}{string[]; \code{NA} when no accession filter was given. Filter accessions no database contained, in the order given. Matching is exact: P04406-1 does not find P04406.}
\item{\code{caveats}}{string[]; never \code{NA}. Whole-result traps, e.g. proteins with no computable mass.}
\item{\code{files}}{object[]; never \code{NA}. One per input in input order (BULK.md §3): source_index, path (absolute), file_type (UniProtXml | Fasta | null if it failed first), reader, contaminant, protein_count, decoy_count, record_count, search_database_sha256 (null here), caveats, absent_fields, error (null or \{kind: usage|correctness, type, message\}). Present with \code{--path} too, so one shape serves both.}
\item{\code{column_names}}{string[]; \code{NA} when the proteins table was not requested. Column order of the proteins table.}
\item{\code{proteins} (wire \code{columns})}{table; \code{NA} when the proteins table was not requested. Column name to per-protein values.}
\item{\code{go_terms}}{object; \code{NA} when go_terms was not requested. \{row_count, column_names, columns\}: one row per (protein, GO id), with columns source_index, source_path, accession, go_id, aspect, term_name, evidence_codes, projects (typed under result.tables.go_terms in this spec).}
\item{\code{ensembl_genes}}{object; \code{NA} when ensembl_genes was not requested. \{row_count, column_names, columns\}: one row per (protein, Ensembl transcript), with columns source_index, source_path, accession, transcript_id, protein_id, gene_id, versioned_gene_id, gene_version (typed under result.tables.ensembl_genes in this spec).}
}
}
\section{Columns of \code{proteins}}{
\describe{
\item{\code{source_index}}{int; never \code{NA}. Position of the input in files (paths first, in order).}
\item{\code{source_path}}{string; never \code{NA}. Absolute path of that input.}
\item{\code{accession}}{string; never \code{NA}. As the database wrote it. A FASTA with a repeated accession gets _2, _3 appended by mzLib; an XML entry with an applied genotype variant gets a variant suffix (see caveats).}
\item{\code{name}}{string; \code{NA} when the database records no entry name. Entry name, e.g. G3P_HUMAN.}
\item{\code{full_name}}{string; \code{NA} when the database records no protein name. Recommended protein name.}
\item{\code{organism}}{string; \code{NA} when the database records no organism. Scientific name (the XML organism element, FASTA OS=).}
\item{\code{ncbi_taxonomy_id}}{string; \code{NA} when the entry records no taxonomy id (a FASTA header without OX=). NCBI taxon, e.g. "9606". A string because it is an identifier.}
\item{\code{primary_gene_name}}{string; \code{NA} when the entry names no primary gene. Primary gene name (the XML gene name of type primary, FASTA GN=).}
\item{\code{gene_names}}{string[]; never \code{NA}. Every gene name the entry gives, in file order (primary, synonyms, ORF, locus). May be empty; may repeat when the file repeats.}
\item{\code{length}}{int; in \strong{residues}; never \code{NA}. Sequence length.}
\item{\code{monoisotopic_mass}}{float; in \strong{Da}; \code{NA} when the sequence holds a letter with no defined residue mass (X, B, Z, J). Monoisotopic mass of the unmodified sequence as written plus one water: the precursor, initiator Met and signal peptide included.}
\item{\code{is_contaminant}}{bool; never \code{NA}. Loaded from a database marked contaminant.}
\item{\code{is_decoy}}{bool; never \code{NA}. The file marks it a decoy (accession prefix DECOY). None are generated.}
\item{\code{is_entrapment}}{bool; never \code{NA}. mzLib's entrapment flag (FASTA accession containing 'Random', case-insensitive).}
\item{\code{ensembl_gene_ids}}{string[]; never \code{NA}. Distinct stable Ensembl gene ids (Protein.EnsemblGeneIds), ordinal order. Empty for a FASTA: see absent_fields.}
\item{\code{sequence}}{string; never \code{NA}. The base sequence. \emph{Present only with \code{sequences}.}}
}
}
\section{Fields of \code{go_terms}}{
\describe{
\item{\code{source_index}}{int; never \code{NA}. Input position.}
\item{\code{source_path}}{string; never \code{NA}. Input path.}
\item{\code{accession}}{string; never \code{NA}. The protein.}
\item{\code{go_id}}{string; never \code{NA}. GO accession, e.g. GO:0005737. Unique per protein.}
\item{\code{aspect}}{string; never \code{NA}. mzLib GoAspect name: BiologicalProcess, CellularComponent, MolecularFunction, or Unknown when UniProt gave no C:/F:/P: prefix (never inferred).}
\item{\code{term_name}}{string; \code{NA} when the reference carried no term property. Term name with the aspect prefix removed.}
\item{\code{evidence_codes}}{string[]; never \code{NA}. ECO ids unioned over UniProt's repeats of this GO id, sorted ordinal. Empty is normal.}
\item{\code{projects}}{string[]; never \code{NA}. Annotating projects (UniProtKB, MGI, HPA, ...), unioned, sorted.}
}
}
\section{Fields of \code{ensembl_genes}}{
\describe{
\item{\code{source_index}}{int; never \code{NA}. Input position.}
\item{\code{source_path}}{string; never \code{NA}. Input path.}
\item{\code{accession}}{string; never \code{NA}. The protein.}
\item{\code{transcript_id}}{string; \code{NA} when the reference named no transcript. Ensembl transcript as UniProt wrote it, versioned.}
\item{\code{protein_id}}{string; \code{NA} when UniProt gave no Ensembl protein id. Ensembl protein id as written.}
\item{\code{gene_id}}{string; never \code{NA}. Stable gene id, e.g. ENSG00000111640: the one to join on.}
\item{\code{versioned_gene_id}}{string; never \code{NA}. As UniProt wrote it, e.g. ENSG00000111640.15; equal to gene_id when unversioned.}
\item{\code{gene_version}}{int; \code{NA} when the id carried no numeric version (absent is not 0). The gene version.}
}
}
\section{Errors}{
Each is an R condition carrying the class shown and \code{mzlib_error}; see \code{\link{mzlib_error}}.

\describe{
\item{\code{mzlib_usage_error} (usage)}{neither or both of path and paths-stdin; contaminant with paths-stdin; no paths on stdin; a blank or repeated path; a role other than target/contaminant; accessions-stdin with no accessions; paths-stdin with accessions-stdin but no '--' line}
\item{\code{mzlib_usage_error} (usage)}{tables names something else; threads 0 or < -1; on-error not fail/skip; an option given without a value}
\item{\code{mzlib_usage_error} (usage)}{a database not named .xml or a FASTA extension; a missing database (under skip: recorded in files[i].error with kind usage)}
\item{\code{mzlib_bridge_error} (correctness)}{mzLib cannot parse a database (malformed XML); under skip, recorded with kind correctness}
\item{\code{mzlib_service_unavailable} (service_unavailable)}{Never raised by this verb.}
}
}
\section{Caveats}{
\itemize{
\item A FASTA carries no GO or Ensembl cross-references: its files[i].absent_fields is [go_terms, ensembl_genes, ensembl_gene_ids] and it contributes no rows to either table. Empty there means the format is silent, not that no annotation exists.
\item Decoys are not generated (DecoyType.None), but decoys already in the file are kept with is_decoy true.
\item Sequence variants are not expanded (maxHeterozygousVariants 0), except that mzLib still applies variants a VCF-annotated XML records a genotype for; such proteins carry a variant accession suffix, and the file's caveats count them.
\item GO terms are the terms as annotated, not propagated up the GO graph.
\item Parallel XML loads share ProteinDbLoader's static modification state; it affects only modification resolution, which this verb does not report, and output was byte-identical at threads 1 and 4.
}
}

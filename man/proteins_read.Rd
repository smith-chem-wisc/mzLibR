\name{proteins_read}
\alias{proteins_read}
\title{Read protein databases: one row per protein, with GO terms and Ensembl genes on request}
\usage{
proteins_read(databases, tables = "proteins", accessions = NULL, contaminants = NULL,
  sequences = FALSE, threads = 1, on_error = "fail", timeout = NULL)
}
\arguments{
\item{databases}{A UniProt XML (\code{.xml}) or FASTA (\code{.fasta}, \code{.fa}, \code{.faa}, \code{.fas}), each
  optionally gzipped, or a character vector of them. Read in the order given, in one bridge

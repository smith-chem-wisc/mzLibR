\section{Parameters: units, ranges and defaults}{
\describe{
\item{\code{studies} (wire \code{--stdin})}{string[]; required; range \code{>= 1 line}. One study per line, tab-separated: feature, estimate, standard_error. No header. A feature's lines need not be adjacent; features are reported in order of first appearance. The estimate must be finite and the standard error finite and positive. Blank lines are skipped.}
\item{\code{confidence}}{float; in \strong{fraction (0 to 1)}; default \code{0.95}; range \code{(0, 1)}. Coverage of the reported interval, as a fraction.}
}
}
\section{Returned fields}{
Each field with its type, its unit, and what \code{NA} means when it is \code{NA}.

\describe{
\item{\code{study_count}}{int; in \strong{studies}; never \code{NA}. Study lines read, over every feature.}
\item{\code{feature_count}}{int; in \strong{features}; never \code{NA}. Distinct features; the table's row count.}
\item{\code{confidence}}{float; in \strong{fraction (0 to 1)}; never \code{NA}. The coverage used, as a fraction.}
\item{\code{row_count}}{int; in \strong{rows}; never \code{NA}. Equal to feature_count.}
\item{\code{column_names}}{string[]; never \code{NA}. The table's columns.}
\item{\code{records} (wire \code{columns})}{table; never \code{NA}. One row per feature.}
\item{\code{caveats}}{string[]; never \code{NA}. Three static caveats.}
}
}
\section{Columns of \code{records}}{
\describe{
\item{\code{feature}}{string; never \code{NA}. As given on stdin.}
\item{\code{studies}}{int; in \strong{studies}; never \code{NA}. Studies pooled for this feature.}
\item{\code{estimate}}{float; in \strong{units of the study estimates}; never \code{NA}. Random-effects pooled estimate.}
\item{\code{standard_error}}{float; in \strong{units of the study estimates}; never \code{NA}. Standard error of the pooled estimate.}
\item{\code{confidence_low}}{float; in \strong{units of the study estimates}; never \code{NA}. Lower bound of the interval: estimate - z standard_error.}
\item{\code{confidence_high}}{float; in \strong{units of the study estimates}; never \code{NA}. Upper bound of the interval.}
\item{\code{p_value}}{float; in \strong{fraction (0 to 1)}; never \code{NA}. Two-sided p-value of the pooled estimate against 0, normal reference. Not adjusted across features.}
\item{\code{tau2}}{float; in \strong{squared units of the study estimates}; never \code{NA}. Between-study variance (DerSimonian-Laird); 0 for one study, and exactly 0 whenever q <= studies - 1.}
\item{\code{q}}{float; in \strong{chi-square statistic (studies - 1 degrees of freedom)}; \code{NA} when one study: no heterogeneity to measure. Cochran's Q.}
\item{\code{i_squared}}{float; in \strong{fraction (0 to 1)}; \code{NA} when one study. Share of the variation attributed to heterogeneity, as a fraction in [0, 1].}
\item{\code{direction_agree}}{int; in \strong{studies}; never \code{NA}. Studies whose estimate has the pooled estimate's sign (a 0 estimate counts for neither).}
\item{\code{direction_disagree}}{int; in \strong{studies}; never \code{NA}. Studies with the opposite sign.}
\item{\code{leave_one_out_max_delta}}{float; in \strong{units of the study estimates}; \code{NA} when one study. Largest absolute change in the pooled estimate from dropping any one study.}
}
}

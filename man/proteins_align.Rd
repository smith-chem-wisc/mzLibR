\section{Columns of \code{records}}{
\describe{
\item{\code{pair_index}}{int; never \code{NA}. 0-based position of the pair among the non-blank stdin lines.}
\item{\code{source_length}}{int; in \strong{residues}; never \code{NA}. The source sequence's length.}

\item{\code{source_residues_facing_gap}}{int; in \strong{residues}; never \code{NA}. Source residues with no target counterpart: an extra or deleted stretch, or an overhang.}
\item{\code{target_residues_facing_gap}}{int; in \strong{residues}; never \code{NA}. Target residues with no source counterpart.}

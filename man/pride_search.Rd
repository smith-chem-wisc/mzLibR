\section{Columns}{
\describe{
\item{\code{accession}}{string; never \code{NA}. The project accession: usually PXD, but also legacy PRD and affinity PAD. Treat it as an opaque key.}
\item{\code{title}}{string; never \code{NA}. Project title.}
\item{\code{project_description}}{string; never \code{NA}. Submitter's free-text description.}
\item{\code{sample_processing_protocol}}{string; never \code{NA}. Free text.}
\item{\code{data_processing_protocol}}{string; never \code{NA}. Free text.}
\item{\code{doi}}{string; never \code{NA}. Dataset DOI, or "" when PRIDE has minted none.}
\item{\code{submission_type}}{string; never \code{NA}. COMPLETE, PARTIAL, AFFINITY or PRIDE (legacy); not a closed set.}
\item{\code{sdrf}}{string; never \code{NA}. The project's SDRF term VALUES flattened by the search index into one space-joined string. Not a file, name or URL; "" on most hits.}
\item{\code{submission_date}}{string; \code{NA} when PRIDE reported no date (mzLib's default DateTime). Bare calendar date yyyy-MM-dd: no time, no offset, because none was sent.}
\item{\code{publication_date}}{string; \code{NA} when PRIDE reported no date. As submission_date.}
\item{\code{updated_date}}{string; \code{NA} when PRIDE reported no date. As submission_date.}
\item{\code{project_tags}}{string[]; never \code{NA}. PRIDE's coarse classification tags. Sparse (2.6\% of 1,600 sampled hits).}
\item{\code{keywords}}{string[]; never \code{NA}. Submitter keywords. May contain empty or whitespace-only strings (about 9\% of hits); passed through, not filtered.}
\item{\code{submitters}}{string[]; never \code{NA}. Display names, flattened from contact objects.}
\item{\code{lab_pis}}{string[]; never \code{NA}. Display names.}
\item{\code{affiliations}}{string[]; never \code{NA}. Display strings.}
\item{\code{instruments}}{string[]; never \code{NA}. Display names only; the CV accessions are not sent by this endpoint.}
\item{\code{softwares}}{string[]; never \code{NA}. Display names.}
\item{\code{quantification_methods}}{string[]; never \code{NA}. Display names, e.g. TMT.}
\item{\code{sample_attributes}}{string[]; never \code{NA}. Sample characteristic VALUES; which characteristic each describes is not recoverable from a hit.}
\item{\code{organisms}}{string[]; never \code{NA}. Display names, e.g. 'Homo sapiens (human)'.}
\item{\code{organism_parts}}{string[]; never \code{NA}. Display names.}
\item{\code{diseases}}{string[]; never \code{NA}. Display names.}
\item{\code{references}}{string[]; never \code{NA}. Each a pre-formatted citation string; no separate PubMed id or DOI.}
\item{\code{experiment_types}}{string[]; never \code{NA}. e.g. Data-independent acquisition.}
\item{\code{project_file_names}}{string[]; never \code{NA}. File names only: not the manifest (no sizes, categories or locations). Use pride files or pride ftp-files to act on files.}
\item{\code{other_omics_links}}{string[]; never \code{NA}. Links to related datasets in other omics repositories.}
\item{\code{highlights}}{map<string,string[]>; never \code{NA}. Why the project matched: PRIDE field name -> matched snippets with the terms wrapped in <em>. Keys vary per hit and per query and cross unchanged (not snake_cased).}
\item{\code{yearly_downloads}}{object[]; never \code{NA}. \{year, count\}: year a string (e.g. "2025"), count downloads in that year. Empty when not reported.}
\item{\code{download_count}}{int; in \strong{downloads}; never \code{NA}. Total downloads. 0 means not reported, never a measured zero.}
\item{\code{avg_downloads_per_file}}{float; in \strong{downloads per file}; never \code{NA}. Mean downloads per file. 0 means not reported.}
\item{\code{percentile}}{int; in \strong{percentile}; never \code{NA}. Download-popularity percentile within PRIDE. 0 means not reported.}
\item{\code{bot_count}}{int; in \strong{downloads}; never \code{NA}. Downloads attributed to crawlers. 0 means not reported (populated on under half of hits).}
\item{\code{hub_count}}{int; in \strong{downloads}; never \code{NA}. Downloads attributed to institutional or aggregating hubs. 0 means not reported.}
\item{\code{organic_count}}{int; in \strong{downloads}; never \code{NA}. Downloads attributed to ordinary human traffic. 0 means not reported.}
}
}

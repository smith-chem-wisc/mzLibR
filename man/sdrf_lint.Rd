\section{Parameters: units, ranges and defaults}{
\describe{
\item{\code{documents} (wire \code{--stdin})}{string[]; required; range \code{>= 1 line}. Exactly as sdrf pool: one document per line, path then optionally a TAB and a label; label all or none. Labels are how the documents column names each file.}
}
}
\section{Returned fields}{
Each field with its type, its unit, and what \code{NA} means when it is \code{NA}.

\describe{
\item{\code{document_count}}{int; in \strong{documents}; never \code{NA}. Documents linted.}
\item{\code{paths}}{string[]; never \code{NA}. The paths in stdin order.}
\item{\code{labels}}{string[]; never \code{NA}. Each document's label: supplied, or mzLib's containing-folder/file-stem default.}
\item{\code{finding_count}}{int; in \strong{findings}; never \code{NA}. Distinct findings (not rows).}
\item{\code{column_names}}{string[]; never \code{NA}. The table's columns.}
\item{\code{records} (wire \code{columns})}{table; never \code{NA}. One row per finding x variant, findings in mzLib's impact order, variants majority first.}
\item{\code{caveats}}{string[]; never \code{NA}. Five static caveats, plus one when no labels were supplied.}
}
}
\section{Columns of \code{records}}{
\describe{
\item{\code{finding_index}}{int; never \code{NA}. 0-based finding; rows of one finding share it.}
\item{\code{kind}}{string; never \code{NA}. AccessionNameConflict | NameAccessionConflict | MixedTermAndFreeText | ColumnNameVariant | ValueCaseVariant (SdrfDriftKind member names).}
\item{\code{concept}}{string; never \code{NA}. What was written inconsistently: an accession, a term name, a normalised free-text value, or a normalised column name (lower-cased, whitespace runs collapsed), by kind.}
\item{\code{column_name}}{string; \code{NA} when a ColumnNameVariant finding, which is about a column's NAME rather than its values. The column whose values drift.}
\item{\code{variant_rank}}{int; never \code{NA}. 0 = the majority spelling, then by frequency. Descriptive, not advice.}
\item{\code{value}}{string; never \code{NA}. This spelling as written; for MixedTermAndFreeText, "controlled vocabulary term" or "free text".}
\item{\code{occurrences}}{int; in \strong{documents}; never \code{NA}. How widely this spelling was used. At 23c2490e every kind counts documents.}
\item{\code{documents}}{string[]; never \code{NA}. Labels of the documents that used this spelling, a list cell (labels are caller text, so no delimiter could be undone).}
}
}

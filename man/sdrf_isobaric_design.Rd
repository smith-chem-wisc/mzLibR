\alias{sdrf_isobaric_design}
\title{Read an isobaric (TMT, TMTpro, iTRAQ, DiLeu) design out of an SDRF, or every reason it cannot be read}
\usage{
sdrf_isobaric_design(path, kit = NULL, plex_column = NULL,
  plex_file_name_pattern = NULL, single_plex = NULL, condition_columns = NULL,
  searched_files = NULL, out = NULL, timeout = 60)
}
\arguments{
\item{path}{Path to a \code{.sdrf.tsv} file.}

\item{kit}{The kit the search used, named as \code{\link{isobaric_kits}} takes it (\code{"TMT10"}, \code{"tmt18"},

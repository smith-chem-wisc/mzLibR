\section{Fields of \code{gene_sets}}{
\describe{
\item{\code{source_file_name}}{string; never \code{NA}. The GTF's file name; for a gene-set table, still the GTF's (EnsemblGeneSet.SourceFileName).}
\item{\code{sha256}}{string; never \code{NA}. Lower-case hex sha256 of the GTF's bytes as read, the compressed bytes for a .gz (EnsemblGeneSet.SourceSha256). manifest.json's gene_set_sha256 and genes resolve's gene_set_sha256 carry the same value, so a resolution and a snapshot can be checked against one gene set.}
\item{\code{release}}{string; \code{NA} when the GTF's file name carries no release. The annotation release from the GTF's name; it may differ from \code{--release} (see the release param).}
\item{\code{genome_build}}{string; \code{NA} when the GTF has no #!genome-build header. e.g. GRCh38.p14.}
\item{\code{genebuild_last_updated}}{string; \code{NA} when the GTF has no #!genebuild-last-updated header. The header's value.}
\item{\code{gene_count}}{int; in \strong{genes}; never \code{NA}. Genes in the set, every biotype.}
}
}
\section{Fields of \code{gene_trees}}{
\describe{
\item{\code{gene_trees$source_file_name} (wire \code{source_file_name})}{string; never \code{NA}. The file's name.}
\item{\code{gene_trees$sha256} (wire \code{sha256})}{string; never \code{NA}. Lower-case hex sha256 of the file's bytes as read (compressed for a .gz).}
\item{\code{gene_trees$release} (wire \code{release})}{string; \code{NA} when the file name carries no .eRELEASE.txt suffix, so the release was not checked. The release parsed from the file name.}
\item{\code{gene_trees$collection} (wire \code{collection})}{string; \code{NA} when the file name does not start COLLECTION.GeneTree_content.. The Compara collection, e.g. vertebrates; manifest.json's collection.}
\item{\code{gene_trees$member_count} (wire \code{member_count})}{int; in \strong{genes}; never \code{NA}. Genes held from the file (ComparaGeneTreeContent.Count): every gene in it, or with \code{--restrict-gene-trees} only those in the gene sets.}
\item{\code{gene_trees$restricted_to_gene_sets} (wire \code{restricted_to_gene_sets})}{string[]; \code{NA} when no \code{--restrict-gene-trees}: every gene in the file was kept. The sha256s of the gene sets the members were restricted to, in ordinal order (ComparaGeneTreeContent.RestrictedToGeneSets).}
}
}

\section{Columns of \code{resolutions}}{
\describe{
\item{\code{source_index}}{int; never \code{NA}. Input position.}
\item{\code{source_path}}{string; never \code{NA}. Input path.}
\item{\code{accession}}{string; never \code{NA}. Verbatim, as the search reported it (a variant suffix kept).}
\item{\code{entry_accession}}{string; never \code{NA}. UniProt entry or unversioned RefSeq accession; verbatim when unrecognized.}
\item{\code{isoform}}{int; \code{NA} when no -N isoform suffix. UniProt isoform number.}
\item{\code{namespace}}{string; never \code{NA}. uniprot | refseq | unrecognized.}
\item{\code{outcome}}{string; never \code{NA}. resolved | multi_gene | off_primary_only | not_in_source | unrecognized_accession | contaminant_not_mapped (GeneResolutionTsv.OutcomeName).}
\item{\code{n_genes}}{int; in \strong{genes}; never \code{NA}. Genes the search database links on the gene set's assembly.}
\item{\code{gene_id}}{string; \code{NA} when the outcome has no gene on the assembly. Stable Ensembl gene id.}
\item{\code{versioned_gene_id}}{string; \code{NA} when no gene on the row. As the database wrote it (e.g. ENSG00000111640.15); for an ensembl_xref row, built from the GTF's version, or null when the GTF has none.}
\item{\code{gene_symbol}}{string; \code{NA} when no gene on the row, or the GTF gives it no gene_name. The release's gene_name: a display label, never a key.}
\item{\code{gene_biotype}}{string; \code{NA} when no gene on the row. The release's gene_biotype ('unknown' when the GTF omits it).}
\item{\code{off_primary_genes}}{int; in \strong{genes}; never \code{NA}. Linked genes outside the gene set (ALT haplotypes, patches, scaffolds): dropped from n_genes, counted here.}
\item{\code{uniprot_gene_name}}{string; \code{NA} when the entry names no primary gene. The database's primary gene name, as a label.}
\item{\code{source}}{string; never \code{NA}. search_database_dbreference, or ensembl_xref for a gene only Ensembl links (it carries the search database's outcome and never changes it).}
\item{\code{search_database_sha256}}{string; never \code{NA}. sha256 of the decompressed database.}
\item{\code{gene_set_release}}{string; \code{NA} when the GTF's file name carries no release. Ensembl release.}
\item{\code{gene_set_sha256}}{string; never \code{NA}. sha256 of the GTF as read.}
\item{\code{ensembl_xref_agrees}}{bool; \code{NA} when no gene on the row, or no \code{--xref}: unknown, not false. Whether Ensembl's xref links this accession to this gene.}
\item{\code{ensembl_xref_info_type}}{string; \code{NA} when Ensembl's xref does not link the pair, or no \code{--xref}. Ensembl's strongest evidence: DIRECT, SEQUENCE_MATCH, INFERRED_PAIR.}
\item{\code{ensembl_xref_sha256}}{string; \code{NA} when no \code{--xref} was given. sha256 of the xref file.}
}

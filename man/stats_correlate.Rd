\section{Columns of \code{records}}{
\describe{
\item{\code{feature}}{string; never \code{NA}. The feature id from the responses file's first column.}
\item{\code{rho}}{float; in \strong{unitless correlation (-1 to 1)}; \code{NA} when not_estimable (see method). Spearman's rho: Pearson's correlation of the ranks, ties given their average rank. With \code{--given}, the partial rho: the correlation of the feature's and the trait's ranks after each is regressed on the covariates' ranks, all ranked over the complete samples.}
\item{\code{p_value}}{float; in \strong{fraction (0 to 1)}; \code{NA} when not_estimable. Two-sided p-value against rho = 0, computed as method says. 0 when rho is exactly -1 or 1 with the asymptotic test. Not adjusted across features.}
\item{\code{n}}{int; in \strong{samples}; never \code{NA}. Complete samples the correlation used: the response, the trait and (with \code{--given}) every covariate finite.}
\item{\code{has_ties}}{bool; never \code{NA}. Whether any variable (the response, the trait or, with \code{--given}, a covariate) has tied values among the complete samples. Also false when there were too few complete samples to rank at all (n below 3, or below 4 with \code{--given}), where mzLib does not look.}
\item{\code{method}}{string; never \code{NA}. exact (the full permutation distribution of S = sum d^2, for n <= 9 with no ties and no \code{--given}, as R's cor.test exact = TRUE) | asymptotic (t = rho sqrt(df / (1 - rho^2)) on df = n - 2, or n - 2 - k for k covariates kept, as cor.test exact = FALSE and ppcor::pcor.test) | not_estimable (fewer than 3 complete samples, or k + 3 with \code{--given}; a constant variable; or covariates that carry the response or the trait entirely).}
}
}

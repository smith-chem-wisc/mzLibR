\section{Returned fields}{
Each field with its type, its unit, and what \code{NA} means when it is \code{NA}.

\describe{
\item{\code{groups_file}}{string; never \code{NA}. Absolute path of the protein-group table.}
\item{\code{groups_file_sha256}}{string; never \code{NA}. Lower-case hex sha256 of the table's bytes; also the header's source_file_sha256.}
\item{\code{table_row_count}}{int; in \strong{rows}; never \code{NA}. Rows in the table, decoys included.}
\item{\code{decoy_group_count}}{int; in \strong{groups}; never \code{NA}. Decoy rows (label contains D, so an entrapment decoy ED too), skipped: decoys carry no GO.}
\item{\code{group_count}}{int; in \strong{groups}; never \code{NA}. Groups annotated: every non-decoy group, contaminants included, each once even when MetaMorpheus wrote it twice (mzLib #1366).}
\item{\code{annotation_database}}{object; never \code{NA}. \{path, file_type (UniProtXml), reader, protein_count, sha256 (of the DECOMPRESSED bytes), caveats\}.}
\item{\code{go}}{object; never \code{NA}. \{source_file_name, sha256, release (the data-version; null when the file has none), term_count (obsolete terms included)\}.}
\item{\code{skip_unknown_go_ids}}{bool; never \code{NA}. Whether skip-unknown-go-ids was given.}
\item{\code{unresolved_go_ids}}{string[]; never \code{NA}. GO ids the database cites that the release lacks, in ordinal order. Always empty without skip-unknown-go-ids (the call fails instead).}
\item{\code{header}}{map<string,string>; never \code{NA}. The #!key value header GoAnnotationTsv.Write produced, read back: go_annotation_format, mzlib_version, mzlib_release, go_release, go_obo_sha256, annotation_db_sha256, source_file_sha256, unresolved_go_ids (only when some were dropped), counter_q_value_max, n_multi_member_groups and status_<status>. The counters count GROUPS at q <= counter_q_value_max, not rows.}
\item{\code{row_count}}{int; in \strong{rows}; never \code{NA}. Rows in the whole table.}
\item{\code{returned_count}}{int; in \strong{rows}; never \code{NA}. Rows in columns.}
\item{\code{offset}}{int; in \strong{rows}; never \code{NA}. The offset applied.}
\item{\code{truncated}}{bool; never \code{NA}. True whenever rows were left out of columns by limit or offset.}
\item{\code{caveats}}{string[]; never \code{NA}. Ids dropped from the database, a go.obo with no data-version, and the database's own load caveats.}
\item{\code{written}}{object; \code{NA} when out was not given. \{path, row_count\}; row_count is the whole table.}
\item{\code{categories}}{object; \code{NA} when category-map was not given. \{map_name, map_version, source_file_name, sha256, anchor_count, row_count, column_names [go_id, category, subcategory], columns\}: GoCategoryTsv's rows read back. subcategory is "category:subcategory", or null where the term reaches only the category's own anchor. A term under no anchor has no row.}
\item{\code{categories_written}}{object; \code{NA} when categories-out was not given. \{path\}.}
\item{\code{column_names}}{string[]; never \code{NA}. Exactly GoAnnotationTsv.Schema's headers, in its order (a bridge test holds them equal).}
\item{\code{annotations} (wire \code{columns})}{table; never \code{NA}. Column name to per-row values, for the returned window.}
}
}
\section{Columns of \code{annotations}}{
\describe{
\item{\code{protein_group}}{string; never \code{NA}. The group as MetaMorpheus named it, members |-joined.}
\item{\code{accession_used}}{string[]; never \code{NA}. Members carrying the term, directly or by propagation, ordinal order. Empty on a term-less row.}
\item{\code{accession_direct}}{string[]; never \code{NA}. Of those, members annotated to this exact term.}
\item{\code{accession_inherited}}{string[]; never \code{NA}. Of those, members whose terms were borrowed: a UniProt isoform or mzLib sequence variant takes its entry's terms when it has none of its own.}
\item{\code{go_id}}{string; \code{NA} when a term-less row: the group has no term (annotation_status says why). The term's primary id (an alternative id in the database resolves to it).}
\item{\code{go_name}}{string; \code{NA} when a term-less row. The term's name in this release.}
\item{\code{aspect}}{string; \code{NA} when a term-less row. biological_process | cellular_component | molecular_function | unknown, spelled by mzLib's own schema column.}
\item{\code{evidence}}{string[]; never \code{NA}. Evidence codes (ECO) pooled over the carrying members, ordinal order.}
\item{\code{evidence_by_member}}{map<string,string[]>; never \code{NA}. Member to its own evidence codes for this term; empty on a term-less row. The file spells it member=code,code;member=code.}
\item{\code{inherited}}{bool; \code{NA} when a term-less row. True when every carrying member's terms were borrowed (accession_inherited covers accession_used).}
\item{\code{propagated}}{bool; \code{NA} when a term-less row. True when no member is annotated to this exact term: it is implied by a more specific one, over is_a or part_of.}
\item{\code{n_members}}{int; in \strong{proteins}; never \code{NA}. Members in the group.}
\item{\code{n_with}}{int; in \strong{proteins}; never \code{NA}. Members carrying the term; 0 on a term-less row. n_with == n_members is the consensus view.}
\item{\code{entrapment_members}}{string[]; never \code{NA}. The group's entrapment members (ProteinDbLoader.IsEntrapmentAccession, or marked so by the database), on every row of the group.}
\item{\code{annotation_status}}{string; never \code{NA}. annotated | no_go_terms | no_entry | contaminant (GoAnnotationTsv.StatusName). A row with a term is always annotated.}
\item{\code{q_value}}{float; in \strong{fraction (0 to 1)}; never \code{NA}. The group's q-value from the table. Never filtered on.}
\item{\code{go_release}}{string; \code{NA} when the go.obo has no data-version header. The ontology release, e.g. releases/2026-07-26.}
\item{\code{go_obo_sha256}}{string; never \code{NA}. sha256 of the go.obo.}
\item{\code{annotation_db_sha256}}{string; never \code{NA}. sha256 of the decompressed annotation database.}
}
}

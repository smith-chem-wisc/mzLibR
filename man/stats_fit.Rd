\item{\code{contrasts$row_count} (wire \code{row_count})}{int; in \strong{rows}; never \code{NA}. feature_count x the number of contrasts.}
\item{\code{contrasts$column_names} (wire \code{column_names})}{string[]; never \code{NA}. The contrasts table's columns, in order (result.tables.contrasts.columns).}
\item{\code{contrasts$records} (wire \code{columns})}{table; never \code{NA}. One row per (contrast, feature): contrast blocks in file order, features in file order.}

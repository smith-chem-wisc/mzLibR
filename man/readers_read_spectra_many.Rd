\name{readers_read_spectra_many}
\alias{readers_read_spectra_many}
\title{Read the scans of many spectra files, in one bridge call}
\usage{
readers_read_spectra_many(paths, ms_order = NULL, peaks = FALSE, out = NULL,
  threads = 1, on_error = "fail", timeout = NULL)
}
\arguments{
\item{paths}{A character vector of paths to spectra files. Bruker \code{.d} directories are accepted.}

\item{ms_order}{Keep only scans at this MS level in every file, or \code{NULL} for every level.}

\item{peaks}{Include the \code{mz} and \code{intensity} arrays. \code{FALSE} by default.}

\item{out}{Write the long table here as tab-separated text and return only a summary.}

\item{threads}{Files read at once. \code{1}, the default, holds one whole file in memory at a time;
  \code{-1} uses one per core. The table does not depend on it.}

\item{on_error}{\code{"fail"}, the default, or \code{"skip"} to record an unreadable file in \code{files} and
  read the rest.}

\item{timeout}{Seconds to allow, or \code{NULL} to wait indefinitely.
}


\section{Columns of \code{records}}{
\describe{
\item{\code{severity}}{string; never \code{NA}. Error (cannot be reliably consumed) or Warning (deviates, still joinable). mzLib's SdrfValidationSeverity member name.}
\item{\code{rule}}{string; never \code{NA}. Stable rule id: EmptyHeader, RequiredColumn, RecommendedColumn, EmptyColumnName, ColumnNameCase, MalformedColumnName, ColumnOrdering, NoRows, RowWidth, EmptyCell, ReservedWordCase, NonIntegerValue, RowKeyUniqueness (at 23c2490e).}
\item{\code{message}}{string; never \code{NA}. Human-readable, including the offending value.}
\item{\code{row_index}}{int; \code{NA} when the finding is about the whole document (a missing column, an empty header, no rows), not one row. 0-based index into the data rows.}
\item{\code{line_number}}{int; \code{NA} when same as row_index: a document-level finding. 1-based line in the file: row_index + 2, because the header is line 1.}
\item{\code{column_name}}{string; \code{NA} when the finding is not about one column (RowWidth, RowKeyUniqueness, NoRows, EmptyHeader). The column involved; for a ragged row's extra cells, "(column N)".}
}
}

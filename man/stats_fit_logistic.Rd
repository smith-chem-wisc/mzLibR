}
}
\section{Columns of \code{records}}{
\describe{
\item{\code{feature}}{string; never \code{NA}. The feature id from the responses file's first column.}
\item{\code{coefficient}}{string; never \code{NA}. The coefficient this row reports.}
\item{\code{status}}{string; never \code{NA}. fitted | too_few_observations (no more observed samples than coefficients) | rank_deficient (the design restricted to the observed samples is not of full rank) | separated (the observed outcomes are all 0, all 1, or split by the design, so no finite maximum-likelihood estimate exists; mzLib calls a fit separated when a fitted probability comes within LogisticRegression.SeparationThreshold, 1e-10 at d10017ce, of 0 or 1) | not_converged (still changing at max-iterations). Only fitted rows carry statistics.}
\item{\code{estimate}}{float; in \strong{log-odds per coefficient unit (the log odds ratio for a 0/1 column)}; \code{NA} when status is not fitted. The maximum-likelihood coefficient on the logit scale. exp(estimate) is the odds ratio.}
\item{\code{standard_error}}{float; in \strong{log-odds per coefficient unit}; \code{NA} when not fitted. From the inverse Fisher information at the estimate.}
\item{\code{z}}{float; in \strong{standard errors}; \code{NA} when not fitted. Wald statistic, estimate / standard_error.}
\item{\code{p_value}}{float; in \strong{fraction (0 to 1)}; \code{NA} when not fitted. Two-sided Wald p-value against a coefficient of 0, from the standard normal. Not adjusted across features.}
\item{\code{deviance}}{float; in \strong{deviance (-2 x log-likelihood, natural log)}; \code{NA} when not fitted. The feature's residual deviance; the same in every coefficient block.}
\item{\code{iterations}}{int; in \strong{iterations}; never \code{NA}. IRLS iterations used. 0 when no fit was attempted (too_few_observations, rank_deficient, or every outcome the same); max-iterations when not_converged; a separated feature that IRLS ran on reports the iterations it ran.}
\item{\code{observed}}{int; in \strong{samples}; never \code{NA}. Samples with a 0 or 1 for this feature.}
\item{\code{events}}{int; in \strong{samples}; never \code{NA}. Observed samples whose outcome is 1.}
}
}

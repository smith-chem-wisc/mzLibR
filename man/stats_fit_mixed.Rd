\section{Columns of \code{records}}{
\describe{
\item{\code{feature}}{string; never \code{NA}. The feature id from the responses file's first column.}
\item{\code{coefficient}}{string; never \code{NA}. The coefficient this row reports.}
\item{\code{status}}{string; never \code{NA}. fitted | too_few_observations (no more observed samples than coefficients) | rank_deficient (the design restricted to the observed samples is not of full rank) | too_few_groups (fewer than two observed groups, or no group observed twice, so group and residual variance cannot be told apart) | variance_ratio_at_limit (group_variance / residual_variance ran to the top of mzLib's search, e^12, typically near-identical replicates within each group) | not_converged (the likelihood at the chosen variance ratio could not be evaluated: a non-finite value, or a residual sum of squares of 0 or below). Only fitted rows carry statistics.}
\item{\code{estimate}}{float; in \strong{response units per coefficient unit (e.g. log2 fold change for a 0/1 column on log2 intensities)}; \code{NA} when status is not fitted. The generalized-least-squares fixed-effect coefficient at the estimated variances: the effect within groups, each group keeping its own baseline.}
\item{\code{standard_error}}{float; in \strong{response units per coefficient unit}; \code{NA} when not fitted. sqrt of the diagonal of s^2 (X' V^-1 X)^-1 with s^2 = RSS / (observed - coefficients), under both estimators, as nlme's summary reports.}
\item{\code{df}}{float; in \strong{degrees of freedom}; \code{NA} when not fitted, or the containment df is not positive (a group-level coefficient with too few observed groups to test it). Denominator df of the t test, by nlme's containment rule for one grouping level, a whole number: observed - observed groups - within-group coefficients for a coefficient that varies within some group and for the intercept; observed groups - group-level coefficients, minus 1 more with an intercept, for one constant within every group.}
\item{\code{t}}{float; in \strong{standard errors}; \code{NA} when not fitted. Wald statistic, estimate / standard_error. Reported even when df is null.}
\item{\code{p_value}}{float; in \strong{fraction (0 to 1)}; \code{NA} when not fitted, or df is null. Two-sided p-value of the t test on df. Not adjusted across features.}
\item{\code{residual_variance}}{float; in \strong{squared response units}; \code{NA} when not fitted. sigma^2, the within-group variance: RSS / (observed - coefficients) under reml, RSS / observed under ml. The same in every coefficient block.}
\item{\code{group_variance}}{float; in \strong{squared response units}; \code{NA} when not fitted. tau^2, the between-group variance of the random intercept. 0 is the boundary estimate (no between-group variance), which nlme cannot reach and reports as a tiny positive value. The same in every coefficient block.}
\item{\code{log_likelihood}}{float; in \strong{log-likelihood (natural log)}; \code{NA} when not fitted. The maximized log-likelihood, restricted under reml. The same in every coefficient block.}
\item{\code{observed}}{int; in \strong{samples}; never \code{NA}. Samples with a finite response for this feature.}
\item{\code{groups}}{int; in \strong{groups}; never \code{NA}. Distinct groups among this feature's observed samples.}
}
}

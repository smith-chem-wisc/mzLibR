\section{Columns of \code{records}}{
\describe{
\item{\code{feature}}{string; never \code{NA}. The feature id from the first column.}
\item{\code{coefficient}}{string; never \code{NA}. The coefficient this row reports.}
\item{\code{status}}{string; never \code{NA}. fitted | too_few_observations (no more samples with a response of either kind than coefficients) | rank_deficient (the design over those samples is not of full rank) | separated (no estimate exists: a coefficient beyond +-SeparationLimit, 30 at cc67b7a2, on the latent scale, a Hessian that is not positive definite, or nothing measured and every group's counts one-sided, all 0 or all full) | not_converged (the variance search failed, or the likelihood could not be evaluated at its optimum) | too_few_groups (fewer than two groups, or none with two samples). Only fitted rows carry statistics.}
\item{\code{estimate}}{float; in \strong{latent units per coefficient unit (natural log-odds for a logit latent)}; \code{NA} when status is not fitted. The fixed-effect coefficient at the estimated variances: the effect within groups, on the latent scale.}
\item{\code{standard_error}}{float; in \strong{latent units per coefficient unit}; \code{NA} when not fitted. sqrt of the diagonal of H^-1, H = -d2 l / d beta2 at the estimate (l the log-likelihood with the random effects integrated out). With nothing counted, (X' V^-1 X)^-1 as stats fit-mixed reports under reml.}
\item{\code{df}}{float; in \strong{degrees of freedom}; \code{NA} when not fitted, or the containment df is not positive (a group-level coefficient with too few groups). Denominator df of the t test, by nlme's containment rule over the samples with a response of either kind, a whole number.}
\item{\code{t}}{float; in \strong{standard errors}; \code{NA} when not fitted. Wald statistic, estimate / standard_error. Reported even when df is null.}
\item{\code{p_value}}{float; in \strong{fraction (0 to 1)}; \code{NA} when not fitted, or df is null. Two-sided p-value of the t test on df. Not adjusted across features.}
\item{\code{residual_variance}}{float; in \strong{squared latent units}; \code{NA} when not fitted. sigma^2, the run-to-run variance of the latent within a group: estimated, or the value given (residual_variance_given). The same in every coefficient block.}
\item{\code{residual_variance_given}}{bool; never \code{NA}. True when residual_variance is the value the \code{--residual-variance} file gave, not an estimate. Reported whatever the status.}
\item{\code{group_variance}}{float; in \strong{squared latent units}; \code{NA} when not fitted. tau^2, the between-group variance of the random intercept. 0 is the boundary estimate. The same in every coefficient block.}
\item{\code{log_likelihood}}{float; in \strong{log-likelihood (natural log)}; \code{NA} when not fitted. The maximized log-likelihood: under reml the Laplace-approximated restricted likelihood (exactly the restricted likelihood when nothing is counted), under ml the full one. The same in every coefficient block.}
\item{\code{measured}}{int; in \strong{samples}; never \code{NA}. Samples with a finite response for this feature.}
\item{\code{counted}}{int; in \strong{samples}; never \code{NA}. Samples with a count for this feature.}
\item{\code{groups}}{int; in \strong{groups}; never \code{NA}. Distinct groups among this feature's samples with a response of either kind.}
}
}
\section{Fields of \code{link}}{
an \code{mzlibr_detection_link}, a named list of these four numbers.

\describe{
\item{\code{link$intercept} (wire \code{intercept})}{float; in \strong{natural log-odds}; never \code{NA}. a: the per-trial log-odds at latent 0 and depth 0.}
\item{\code{link$slope} (wire \code{slope})}{float; in \strong{natural log-odds per latent unit}; never \code{NA}. b: how fast the per-trial log-odds follow the latent; 1 for the identity link, below 1 when the chance of a success rises more slowly than the latent.}
\item{\code{link$depth_slope} (wire \code{depth_slope})}{float; in \strong{natural log-odds per depth unit}; never \code{NA}. c: the depth term's coefficient; 0 when the link has none.}
\item{\code{link$overdispersion} (wire \code{overdispersion})}{float; in \strong{fraction (intra-cell correlation, 0 to < 1)}; never \code{NA}. rho, the correlation of trials within one cell (beta-binomial); 0 is the binomial.}
}
}
